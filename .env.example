# PostgreSQL
POSTGRES_DB=agente_compras
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me

# Backend (SQLAlchemy). No Docker, o Compose redefine host para o serviço postgres.
DATABASE_URL=postgresql+psycopg2://postgres:change-me@localhost:5432/agente_compras

# Google AI Studio (Gemini). Preencha a chave localmente; nunca commite o arquivo .env
GEMINI_API_KEY=
LLM_MODEL=gemini/gemini-3.6-flash

# OpenRouter — legado, não é usado pelo agente ativo
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/xingchen-agi/xing4.0-29b-a4b:free

# Frontend (Vite em desenvolvimento)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# MCP. No Docker, o Compose redefine para http://mcp-server:8080/mcp
MCP_SERVER_URL=http://localhost:8080/mcp
MCP_CONNECT_TIMEOUT_SECONDS=10
MCP_SSE_READ_TIMEOUT_SECONDS=120

# MCP Server
DUMMYJSON_BASE_URL=https://dummyjson.com
HTTP_TIMEOUT_SECONDS=10

PYTHONUTF8=1

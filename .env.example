# PostgreSQL
POSTGRES_DB=agente_compras
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me

# Backend (SQLAlchemy). No Docker, o Compose redefine host para o serviço postgres.
DATABASE_URL=postgresql+psycopg2://postgres:change-me@localhost:5432/agente_compras

# Provedor ativo: gemini (Google AI Studio) ou openrouter
LLM_PROVIDER=gemini

# Google Gemini direto. Usado somente quando LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini/gemini-3.6-flash
# Legado: usado pelo Gemini somente se GEMINI_MODEL estiver vazio
LLM_MODEL=gemini/gemini-3.6-flash

# OpenRouter. Usado somente quando LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/google/gemini-3.6-flash

# Limite de tokens de saída enviado ao LiteLLM (OpenRouter reserva o max_tokens)
LLM_MAX_OUTPUT_TOKENS=4096

# Frontend (Vite em desenvolvimento)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# MCP. No Docker, o Compose redefine para http://mcp-server:8080/mcp
MCP_SERVER_URL=http://localhost:8080/mcp
MCP_CONNECT_TIMEOUT_SECONDS=10
MCP_SSE_READ_TIMEOUT_SECONDS=120

# MCP Server
DUMMYJSON_BASE_URL=https://dummyjson.com
HTTP_TIMEOUT_SECONDS=10

PYTHONUTF8=1
